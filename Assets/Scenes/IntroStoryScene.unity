--- !u!114 &1185448004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1185448002}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB2E8 \uD55C \uBC88\uC758 \uC798\uBABB\uB41C \uC0AC\uC6A9\uC740\r\n\uC9C0\uC5ED
    \uC77C\uB300\uB97C \uC2EC\uAC01\uD558\uAC8C \uC624\uC5FC\uC2DC\uD0A4\uB294 \uACB0\uACFC\uB97C
    \uCD08\uB798\uD588\uB2E4.\r\n\r\n\uC624\uC5FC\uC740 \uACF5\uC7A5 \uB0B4\uBD80\uC5D0\uC11C
    \uC2DC\uC791\uB418\uC5C8\uC9C0\uB9CC,\r\n\uC774\uBBF8 \uC8FC\uBCC0 \uAD6C\uC5ED\uAE4C\uC9C0
    \uBE60\uB974\uAC8C \uBC88\uC838 \uB098\uAC00\uACE0 \uC788\uB2E4.\r\n\r\n\uC0C1\uD669\uC774
    \uB354 \uC545\uD654\uB418\uAE30 \uC804\uC5D0\r\n\uC624\uC5FC\uC758 \uADFC\uC6D0\uC744
    \uCC3E\uC544 \uD604\uC7A5\uC744 \uC218\uC2B5\uD574\uC57C \uD55C\uB2E4.\r\n\r\nTO21\uC740
    \uC0AC\uD0DC \uC218\uC2B5\uC744 \uC704\uD574 \uD604\uC7A5 \uB300\uC751 \uC9C1\uC6D0\uC744
    \uAE34\uAE09 \uD30C\uACAC\uD588\uB2E4.\r\n\uB2F9\uC2E0\uC740 \uADF8 \uC784\uBB34\uB97C
    \uB9E1\uC544 \uBB38\uC81C\uC758 \uACF5\uC7A5\uC73C\uB85C \uD22C\uC785\uB418\uC5C8\uB2E4.\r\n\r\n\uB2F9\uC2E0\uC758
    \uC784\uBB34\uB294 \uB2E8\uC21C\uD55C \uC9C4\uC785\uC774 \uC544\uB2C8\uB2E4.\r\n\uC624\uC5FC\uC758
    \uADFC\uC6D0\uC744 \uC2DD\uBCC4\uD558\uACE0, \uC801\uC808\uD55C \uC7A5\uBE44\uB85C
    \uC815\uD654\uD558\uBA70,\r\n\uB354 \uD070 \uD53C\uD574\uAC00 \uBC1C\uC0DD\uD558\uAE30
    \uC804\uC5D0 \uD604\uC7A5\uC744 \uC548\uC815\uD654\uD558\uB294 \uAC83\uC774\uB2E4.\r\n\r\n\uACF5\uC7A5
    \uB0B4\uBD80\uC5D0\uB294\r\n\uC0B0\uC131 \uBB3C\uC9C8, \uC720\uB958, \uD63C\uD569
    \uD654\uD559\uC561\uC774 \uB4A4\uC11E\uC5EC \uB0A8\uC544 \uC788\uB2E4.\r\n\r\n\uAC01
    \uC624\uC5FC\uC6D0\uC740 \uC131\uC9C8\uC774 \uB2E4\uB974\uBA70,\r\n\uC798\uBABB\uB41C
    \uB300\uC751\uC740 \uB354 \uD070 \uD655\uC0B0\uC73C\uB85C \uC774\uC5B4\uC9C8
    \uC218 \uC788\uB2E4.\r\n\r\n\uC815\uD655\uD558\uAC8C \uD310\uB2E8\uD558\uACE0,\r\n\uC62C\uBC14\uB978
    \uC7A5\uBE44\uB97C \uC120\uD0DD\uD574 \uC624\uC5FC\uC6D0\uC744 \uC815\uD654\uD558\uB77C.\r\n\r\n\uC774\uACF3\uC744
    \uBA48\uCD94\uC9C0 \uBABB\uD558\uBA74\r\n\uC624\uC5FC\uC740 \uC9C0\uC5ED \uC804\uCCB4\uB97C
    \uC9D1\uC5B4\uC0BC\uD0A4\uAC8C \uB41C\uB2E4.\r\n\uC774\uC81C, \uC624\uC5FC \uC9C0\uC5ED
    \uD55C\uAC00\uC6B4\uB370\uB85C \uB4E4\uC5B4\uAC00\uC57C \uD55C\uB2E4."
